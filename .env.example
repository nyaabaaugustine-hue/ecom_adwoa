# ============================================================
# ADWOA'S BEAUTY — ENVIRONMENT VARIABLES (TEMPLATE)
# Copy to .env or .env.local and fill in real values.
# NEVER commit .env or .env.local to git.
# ============================================================

# ─── DATABASE (Neon PostgreSQL) ───────────────────────────────
# Pooled connection URL (for serverless / app runtime)
DATABASE_URL="postgresql://neondb_owner:PASSWORD@ep-YOUR-ENDPOINT-pooler.c-12.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Direct connection URL (for migrations, admin, heavy batch jobs only)
DATABASE_DIRECT_URL="postgresql://neondb_owner:PASSWORD@ep-YOUR-ENDPOINT.c-12.us-east-1.aws.neon.tech/neondb?sslmode=require"

# ─── PAYSTACK ─────────────────────────────────────────────────
PAYSTACK_SECRET_KEY="sk_live_YOUR_SECRET_KEY"
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_live_YOUR_PUBLIC_KEY"

# ─── APP ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://adwoasbeauty.com"
NEXT_PUBLIC_APP_NAME="Adwoa's Beauty"
NEXT_PUBLIC_CURRENCY="GHS"

# ─── CLOUDINARY (images) ──────────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="dwsl2ktt2"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# ─── AUTH ─────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
JWT_SECRET="change-me-to-a-random-64-char-string"
NEXTAUTH_SECRET="change-me-to-another-random-string"
NEXTAUTH_URL="https://adwoasbeauty.com"

# ─── EMAIL (SMTP) ─────────────────────────────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="noreply@adwoasbeauty.com"
SMTP_PASS="your_app_password"

# ─── DATABASE POOLING ─────────────────────────────────────────
# Connection pool limits (for @neondatabase/serverless)
PGPOOL_MIN=1
PGPOOL_MAX=5
